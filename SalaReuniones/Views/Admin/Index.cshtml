@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Administración de Usuarios";
}

<!-- ========================================================= -->
<!-- TITULO -->
<!-- ========================================================= -->
<h2 class="mb-3">Gestión de Usuarios</h2>

<!-- ========================================================= -->
<!-- BOTÓN CREAR -->
<!-- Redirige a la acción Create del AdminController -->
<!-- ========================================================= -->
<a asp-action="Create" class="btn btn-primary mb-3">
    ➕ Crear Usuario
</a>

<!-- ========================================================= -->
<!-- MENSAJES TEMPORALES -->
<!-- TempData["Error"] y TempData["Success"] definidos en el Controller -->
<!-- ========================================================= -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<!-- ========================================================= -->
<!-- TABLA DE USUARIOS -->
<!-- ========================================================= -->
<table class="table table-bordered table-hover">

    <!-- CABECERA -->
    <thead class="table-dark">
        <tr>
            <th>Usuario</th> <!-- Antes era Email, ahora coincide con UserName -->
            <th>Rol</th>
            <th>Estado</th> <!-- Indica Activo / Inhabilitado -->
            <th style="width: 220px;">Acciones</th> <!-- Editar / Inhabilitar / Activar -->
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <!-- ===================================================== -->
                <!-- NOMBRE DE USUARIO -->
                <!-- ===================================================== -->
                <td>@user.UserName</td>

                <!-- ===================================================== -->
                <!-- ROL ASIGNADO -->
                <!-- Muestra "SIN ROL" si no tiene ninguno -->
                <!-- ===================================================== -->
                <td>@(user.Role ?? "SIN ROL")</td>

                <!-- ===================================================== -->
                <!-- ESTADO DEL USUARIO -->
                <!-- Verde: Activo, Rojo: Inhabilitado -->
                <!-- ===================================================== -->
                <td>
                    @if (user.Estado == "Activo")
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inhabilitado</span>
                    }
                </td>

                <!-- ===================================================== -->
                <!-- ACCIONES -->
                <!-- Editar: siempre disponible -->
                <!-- Inhabilitar / Activar: dinámico según estado -->
                <!-- ===================================================== -->
                <td>
                    <!-- EDITAR -->
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        ✏️ Editar
                    </a>

                    <!-- BOTÓN DINÁMICO -->
                    @if (user.Estado == "Activo")
                    {
                        <!-- INHABILITAR -->
                        <a asp-action="Delete"
                           asp-route-id="@user.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Seguro que deseas inhabilitar este usuario?')">
                            🚫 Inhabilitar
                        </a>
                    }
                    else
                    {
                        <!-- ACTIVAR -->
                        <form asp-action="Activar" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button class="btn btn-success btn-sm">
                                ✅ Activar
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>

</table>

<!-- ========================================================= -->
<!-- NOTAS TÉCNICAS -->
<!--
    ✔ Ahora muestra estado del usuario (Activo / Inhabilitado)
    ✔ Inhabilitar usa LockoutEnd (no elimina de la BD)
    ✔ Activar restaura acceso
    ✔ Mantiene historial del sistema
    ✔ UX tipo sistema empresarial
    ✔ Compatible con AdminController.cs 4 CO
-->
<!-- ========================================================= -->