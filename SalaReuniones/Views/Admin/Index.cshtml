@model SalaReuniones.ViewModels.UserListViewModel

@{
    ViewData["Title"] = "Administración de Usuarios";
}

<h2 class="mb-3">Gestión de Usuarios</h2>

<!-- ========================================================= -->
<!-- BOTÓN CREAR -->
<!-- ========================================================= -->
<a asp-action="Create" class="btn btn-primary mb-3">
    ➕ Crear Usuario
</a>

<!-- ========================================================= -->
<!-- MENSAJES -->
<!-- ========================================================= -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<!-- ========================================================= -->
<!-- BUSQUEDA Y FILTRO -->
<!-- ========================================================= -->
<form method="get" class="row g-2 mb-3">

    <!-- BUSCAR USERNAME -->
    <div class="col-md-4">
        <input type="text"
               name="search"
               value="@Model.Search"
               class="form-control"
               placeholder="Buscar usuario..." />
    </div>

    <!-- FILTRO ROL -->
    <div class="col-md-3">
        <select name="roleFilter" class="form-control">

            <option value="">Todos los roles</option>

            @foreach (var role in ViewBag.Roles)
            {
                <option value="@role"
                        selected="@(role == Model.RoleFilter)">
                    @role
                </option>
            }

        </select>
    </div>

    <!-- BOTÓN BUSCAR -->
    <div class="col-md-2">
        <button class="btn btn-dark w-100">
            🔎 Buscar
        </button>
    </div>

</form>

<!-- ========================================================= -->
<!-- TABLA DE USUARIOS -->
<!-- ========================================================= -->
<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>Usuario</th>
            <th>Rol</th>
            <th>Estado</th>
            <th style="width:230px;">Acciones</th>
        </tr>
    </thead>

    <tbody>

        @if (!Model.Users.Any())
        {
            <tr>
                <td colspan="4" class="text-center">
                    No se encontraron usuarios
                </td>
            </tr>
        }

        @foreach (var user in Model.Users)
        {
            <tr>

                <!-- USERNAME -->
                <td>@user.UserName</td>

                <!-- ROL -->
                <td>@(string.IsNullOrEmpty(user.Role) ? "SIN ROL" : user.Role)</td>

                <!-- ESTADO -->
                <td>

                    @if (user.Estado == "Activo")
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inhabilitado
                        </span>
                    }

                </td>

                <!-- ACCIONES -->
                <td>

                    <!-- EDITAR -->
                    <a asp-action="Edit"
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        ✏️ Editar
                    </a>

                    @if (user.Estado == "Activo")
                    {
                        <!-- INHABILITAR -->
                        <a asp-action="Delete"
                           asp-route-id="@user.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Seguro que deseas inhabilitar este usuario?')">
                            🚫 Inhabilitar
                        </a>
                    }
                    else
                    {
                        <!-- ACTIVAR -->
                        <form asp-action="Activar"
                              method="post"
                              style="display:inline;">

                            <input type="hidden"
                                   name="id"
                                   value="@user.Id" />

                            <button class="btn btn-success btn-sm">
                                ✅ Activar
                            </button>

                        </form>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>

<!-- ========================================================= -->
<!-- PAGINACIÓN -->
<!-- ========================================================= -->
<nav>

    <ul class="pagination justify-content-center">

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">

                <a class="page-link"
                   href="?page=@i&search=@Model.Search&roleFilter=@Model.RoleFilter">

                    @i

                </a>

            </li>
        }

    </ul>

</nav>