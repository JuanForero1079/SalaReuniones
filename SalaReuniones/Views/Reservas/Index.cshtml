@model IEnumerable<SalaReuniones.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

<p>
    @* Mostrar botón Crear solo a Admin o Usuario *@
    @if (User.IsInRole("Administrador") || User.IsInRole("Usuario"))
    {
        <a asp-action="Create" class="btn btn-primary">Crear Nueva Reserva</a>
    }
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Fecha)</th>
            <th>@Html.DisplayNameFor(model => model.HoraInicio)</th>
            <th>@Html.DisplayNameFor(model => model.HoraFin)</th>
            <th>@Html.DisplayNameFor(model => model.Motivo)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>@Html.DisplayName("Sala")</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@item.Fecha.ToShortDateString()</td>
                <td>@Html.DisplayFor(modelItem => item.HoraInicio)</td>
                <td>@Html.DisplayFor(modelItem => item.HoraFin)</td>
                <td>@Html.DisplayFor(modelItem => item.Motivo)</td>
                <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                @* Sala puede ser nula, usamos ?. y ?? para valor por defecto *@
                <td>@(item.Sala?.Nombre ?? "No asignada")</td>
                <td>
                    @* Editar: Admin puede todo, Usuario solo su reserva *@
                    @if (User.IsInRole("Administrador") || (User.IsInRole("Usuario") && item.Nombre == User.Identity?.Name))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    }

                    @* Detalles: Todos pueden ver *@
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>

                    @* Eliminar: Solo Admin *@
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>