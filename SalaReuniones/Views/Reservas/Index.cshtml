@model IEnumerable<SalaReuniones.Models.Reserva>
@using System.Security.Claims
@using System.Linq
@using SalaReuniones.Models

@{
    ViewData["Title"] = "Reservas";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Reservas</h1>

    <div>
        <a asp-action="Calendar" class="btn btn-outline-primary me-2">
            Ver Calendario
        </a>

        @if (User.IsInRole("Administrador") || User.IsInRole("Usuario"))
        {
            <a asp-action="Create" class="btn btn-primary">
                Crear Nueva Reserva
            </a>
        }
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No hay reservas registradas.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>Usuario</th>
                <th>Fecha</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Sala</th>
                <th style="width:220px;">Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.OrderBy(r => r.Fecha).ThenBy(r => r.HoraInicio))
            {
                // ---------------------------------------------------
                // CÁLCULO DE ESTADO DINÁMICO
                // ---------------------------------------------------
                var inicio = item.Fecha.Date.Add(item.HoraInicio);
                var fin = item.Fecha.Date.Add(item.HoraFin);
                var ahora = DateTime.Now;

                bool finalizada = item.Estado != EstadoReserva.Cancelada && ahora > fin;
                bool enProceso = item.Estado != EstadoReserva.Cancelada && ahora >= inicio && ahora <= fin;

                string estadoVisual;
                string claseColor;
                string icono;

                if (item.Estado == EstadoReserva.Cancelada)
                {
                    estadoVisual = "Cancelada";
                    claseColor = "bg-secondary";
                    icono = "bi-x-circle";
                }
                else if (finalizada)
                {
                    estadoVisual = "Finalizada";
                    claseColor = "bg-dark";
                    icono = "bi-check-circle";
                }
                else if (enProceso)
                {
                    estadoVisual = "En proceso";
                    claseColor = "bg-warning text-dark";
                    icono = "bi-clock";
                }
                else
                {
                    estadoVisual = "Agendada";
                    claseColor = "bg-success";
                    icono = "bi-calendar-event";
                }

                <tr class="@(enProceso ? "table-warning" : "")">

                    <td>@(item.Usuario?.UserName ?? "Sin usuario")</td>

                    <td>@item.Fecha.ToShortDateString()</td>

                    <td>@item.HoraInicio</td>

                    <td>@item.HoraFin</td>

                    <td>@item.Motivo</td>

                    <td>
                        <span class="badge @claseColor">
                            <i class="bi @icono"></i> @estadoVisual
                        </span>
                    </td>

                    <td>@(item.Sala?.Nombre ?? "No asignada")</td>

                    <td>

                        @if (!finalizada &&
                                        item.Estado == EstadoReserva.Activa &&
                                        (User.IsInRole("Administrador") ||
                                        (User.IsInRole("Usuario") &&
                                        item.UsuarioId == User.FindFirstValue(ClaimTypes.NameIdentifier))))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning me-1">
                                Editar
                            </a>
                        }

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-info me-1">
                            Detalles
                        </a>

                        @if (!finalizada &&
                                        item.Estado == EstadoReserva.Activa &&
                                        (User.IsInRole("Administrador") ||
                                        (User.IsInRole("Usuario") &&
                                        item.UsuarioId == User.FindFirstValue(ClaimTypes.NameIdentifier))))
                        {
                            <a asp-action="Cancelar"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger me-1"
                               onclick="return confirm('¿Deseas cancelar esta reserva?');">
                                Cancelar
                            </a>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>
}

<script>
    setInterval(function () {
        location.reload();
    }, 10000);
</script>