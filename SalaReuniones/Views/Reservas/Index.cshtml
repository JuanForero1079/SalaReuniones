@model IEnumerable<SalaReuniones.Models.Reserva>
@using System.Security.Claims
@using System.Linq

@{
    ViewData["Title"] = "Reservas";
}

<h1 class="mb-3">Reservas</h1>

<p>
    @* Botón Crear solo para Administrador o Usuario *@
    @if (User.IsInRole("Administrador") || User.IsInRole("Usuario"))
    {
        <a asp-action="Create" class="btn btn-primary">
            Crear Nueva Reserva
        </a>
    }
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No hay reservas registradas.
    </div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Usuario</th>
                <th>Fecha</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Sala</th>
                <th style="width:180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Usuario?.Email ?? "Sin usuario")</td>
                    <td>@item.Fecha.ToShortDateString()</td>
                    <td>@item.HoraInicio</td>
                    <td>@item.HoraFin</td>
                    <td>@item.Motivo</td>
                    <td>@item.Estado</td>
                    <td>@(item.Sala?.Nombre ?? "No asignada")</td>
                    <td>
                        @* Editar:
                           - Administrador puede editar todo
                           - Usuario solo su propia reserva *@
                        @if (User.IsInRole("Administrador") ||
                                        (User.IsInRole("Usuario") &&
                                        item.UsuarioId == User.FindFirstValue(ClaimTypes.NameIdentifier)))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning me-1">
                                Editar
                            </a>
                        }

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-info me-1">
                            Detalles
                        </a>

                        @* Eliminar solo Administrador *@
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger">
                                Eliminar
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}