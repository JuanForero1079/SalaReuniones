@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Calendario de Reservas";
    var salas = ViewData["Salas"] as SelectList;
}


<!-- ============================================================
     ENCABEZADO
============================================================ -->
<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <div>
                <h2 class="mb-1">
                    Calendario de Reservas
                </h2>

                <p class="text-muted mb-0">
                    Consulta la disponibilidad de las salas y crea una nueva reserva.
                </p>
            </div>

            @if (User.IsInRole("Administrador") || User.IsInRole("Usuario"))
            {
                <a asp-action="Create"
                   class="btn btn-success btn-lg shadow px-4">
                    <i class="bi bi-calendar-plus"></i>
                    Reservar Sala
                </a>
            }

        </div>

    </div>

</div>

<!-- ============================================================
     FILTRO POR SALA
============================================================ -->
<div class="mb-4">

    <label for="filtroSala" class="form-label">
        <strong>Filtrar por Sala</strong>
    </label>

    <select id="filtroSala" class="form-select">

        <option value="">Todas</option>

        @if (salas != null)
        {
            foreach (var sala in salas)
            {
                <option value="@sala.Value">
                    @sala.Text
                </option>
            }
        }

    </select>

</div>

<!-- ============================================================
     CALENDARIO
============================================================ -->
<div id="calendar"></div>

<!-- ============================================================
     MODAL DETALLE
============================================================ -->
<div class="modal fade" id="detalleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle de Reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Título:</strong> <span id="modalTitulo"></span></p>
                <p><strong>Sala:</strong> <span id="modalSala"></span></p>
                <p><strong>Usuario:</strong> <span id="modalUsuario"></span></p>
                <p><strong>Horario:</strong> <span id="modalHorario"></span></p>
                <p><strong>Estado:</strong> <span id="modalEstado"></span></p>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const calendarEl = document.getElementById('calendar');
        const filtroSala = document.getElementById('filtroSala');

        if (!calendarEl) return;

        const calendar = new FullCalendar.Calendar(calendarEl, {

            initialView: 'timeGridWeek',
            locale: 'es',

            slotMinTime: "00:00:00",
            slotMaxTime: "23:59:59",
            allDaySlot: false,

            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },

            // ============================================================
            // CARGA DE EVENTOS
            // ============================================================
            events: function (fetchInfo, successCallback, failureCallback) {

                const salaId = filtroSala ? filtroSala.value : "";

                fetch(`/Reservas/GetReservas?start=${fetchInfo.startStr}&end=${fetchInfo.endStr}&salaId=${salaId}`)
                    .then(response => response.json())
                    .then(data => {

                        const eventos = data.map(r => {

                            //  COLOR BASE (desde BD)
                            let color = r.backgroundColor;

                            // ===================================================
                            // LÓGICA VISUAL POR ESTADO (AQUÍ ESTÁ LA MAGIA)
                            // ====================================================
                            if (r.estado === "finalizada") {
                                // Mismo color pero con opacidad (hex alpha)
                                color = color + "80"; // 50% transparencia
                            }
                            else if (r.estado === "cancelada") {
                                // Color fuerte para indicar problema
                                color = "#8b0000"; // rojo oscuro
                            }
                            // activa → se queda igual

                            return {
                                id: r.id,
                                title: r.title,
                                start: r.start,
                                end: r.end,

                                backgroundColor: color,
                                borderColor: color,

                                extendedProps: {
                                    usuario: r.usuario,
                                    sala: r.sala,
                                    estado: r.estado
                                }
                            };
                        });

                        successCallback(eventos);
                    })
                    .catch(err => failureCallback(err));
            },

            // ============================================================
            // CLICK → MODAL
            // ============================================================
            eventClick: function (info) {

                const modalTitulo = document.getElementById("modalTitulo");
                const modalSala = document.getElementById("modalSala");
                const modalUsuario = document.getElementById("modalUsuario");
                const modalHorario = document.getElementById("modalHorario");
                const modalEstado = document.getElementById("modalEstado");

                if (modalTitulo) modalTitulo.innerText = info.event.title ?? "";
                if (modalSala) modalSala.innerText = info.event.extendedProps.sala ?? "";
                if (modalUsuario) modalUsuario.innerText = info.event.extendedProps.usuario ?? "";

                // HORAS
                if (modalHorario) {
                    const inicio = info.event.start;
                    const fin = info.event.end;

                    const horaInicio = inicio
                        ? inicio.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                        : "";

                    const horaFin = fin
                        ? fin.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                        : "";

                    modalHorario.innerText = horaInicio + " - " + horaFin;
                }

                // ESTADO
                if (modalEstado) {
                    const estado = info.event.extendedProps.estado;

                    if (estado === "finalizada")
                        modalEstado.innerText = "Finalizada";
                    else if (estado === "cancelada")
                        modalEstado.innerText = "Cancelada";
                    else
                        modalEstado.innerText = "Activa";
                }

                const modalElement = document.getElementById('detalleModal');
                if (modalElement) {
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            }
        });

        calendar.render();

        // ============================================================
        // FILTRO
        // ============================================================
        if (filtroSala) {
            filtroSala.addEventListener("change", function () {
                calendar.refetchEvents();
            });
        }
    });
</script>

<style>
    #calendar {
        max-width: 1100px;
        margin: 20px auto;
        min-height: 650px;
    }
</style>