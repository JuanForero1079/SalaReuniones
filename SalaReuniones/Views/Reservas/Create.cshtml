@model SalaReuniones.Models.Reserva

@{
    // Título que se mostrará en la pestaña del navegador
    ViewData["Title"] = "Crear Reserva";
}

<h1>Crear Reserva</h1>

<h4>Reserva</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        <!--
            Formulario que enviará los datos al método Create del controlador.
            IMPORTANTE:
            method="post" permite que se ejecute el método [HttpPost] Create(...)
        -->
        <form asp-action="Create" method="post">

            <!--
                Muestra errores generales del modelo (si ModelState falla)
            -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- ============================= -->
            <!-- CAMPO FECHA -->
            <!-- ============================= -->
            <div class="form-group">
                <!-- Etiqueta automática basada en el modelo -->
                <label asp-for="Fecha" class="control-label"></label>

                <!-- Input tipo date para seleccionar la fecha -->
                <input asp-for="Fecha" type="date" class="form-control" />

                <!-- Muestra error si Fecha es inválida -->
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <!-- ============================= -->
            <!-- CAMPO HORA INICIO -->
            <!-- ============================= -->
            <div class="form-group">
                <label asp-for="HoraInicio" class="control-label"></label>
                <input asp-for="HoraInicio" type="time" class="form-control" />
                <span asp-validation-for="HoraInicio" class="text-danger"></span>
            </div>

            <!-- ============================= -->
            <!-- CAMPO HORA FIN -->
            <!-- ============================= -->
            <div class="form-group">
                <label asp-for="HoraFin" class="control-label"></label>
                <input asp-for="HoraFin" type="time" class="form-control" />
                <span asp-validation-for="HoraFin" class="text-danger"></span>
            </div>

            <!-- ============================= -->
            <!-- CAMPO MOTIVO -->
            <!-- ============================= -->
            <div class="form-group">
                <label asp-for="Motivo" class="control-label"></label>

                <!-- Campo de texto para escribir el motivo -->
                <input asp-for="Motivo" class="form-control" />

                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>

            <!-- ============================= -->
            <!-- SELECCIÓN DE SALA -->
            <!-- ============================= -->
            <div class="form-group">
                <label asp-for="SalaId" class="control-label"></label>

                <!--
                    Lista desplegable cargada desde el controlador
                    ViewBag.SalaId contiene la lista de salas
                -->
                <select asp-for="SalaId"
                        asp-items="ViewBag.SalaId"
                        class="form-control">

                    <!-- Opción por defecto -->
                    <option value="">-- Seleccione una sala --</option>
                </select>

                <span asp-validation-for="SalaId" class="text-danger"></span>
            </div>

            <!-- ============================= -->
            <!-- BOTONES -->
            <!-- ============================= -->
            <div class="form-group mt-3">

                <!--
                    Botón que envía el formulario
                    type="submit" es obligatorio para ejecutar el POST
                -->
                <input type="submit" value="Agendar Reunión" class="btn btn-primary" />

                <!-- Botón para volver a la lista sin guardar -->
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        /*
            Activa validaciones del lado del cliente (JavaScript)
            Para que Required y otras reglas funcionen sin recargar
        */
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}