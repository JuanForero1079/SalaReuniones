@model SalaReuniones.Models.Reserva
@using SalaReuniones.Models
@using System.Security.Claims

@{
    // ==========================================================
    // CONFIGURACIÓN GENERAL
    // ==========================================================

    ViewData["Title"] = "Detalles de Reserva";

    // ==========================================================
    // CÁLCULO DEL ESTADO REAL
    // ==========================================================

    var fechaFin = Model.Fecha.Date.Add(Model.HoraFin);

    bool reservaFinalizada = fechaFin < DateTime.Now;
    bool reservaCancelada = Model.Estado == EstadoReserva.Cancelada;

    // Estado que se mostrará en pantalla
    string estadoVisual;

    if (reservaCancelada)
    {
        estadoVisual = "Cancelada";
    }
    else if (reservaFinalizada)
    {
        estadoVisual = "Finalizada";
    }
    else
    {
        estadoVisual = "Activa";
    }

    // ==========================================================
    // PERMISOS DE EDICIÓN
    // ==========================================================

    bool puedeEditar =
        !reservaFinalizada &&
        !reservaCancelada &&
        (
            User.IsInRole("Administrador") ||
            (
                User.IsInRole("Usuario") &&
                Model.UsuarioId == User.FindFirstValue(ClaimTypes.NameIdentifier)
            )
        );

    // ==========================================================
    // PERMISOS PARA DESCARGAR ICS
    // ==========================================================

    bool puedeDescargar =
    Model.UsuarioId == User.FindFirstValue(ClaimTypes.NameIdentifier);

}   <!-- ESTA LLAVE ES MUY IMPORTANTE -->


<h1>Detalles</h1>

<div>
    <h4>Reserva</h4>
    <hr />

    <dl class="row">

        <!-- USUARIO -->
        <dt class="col-sm-2">
            Usuario
        </dt>

        <dd class="col-sm-10">
            @Model.Usuario?.Email
        </dd>


        <!-- FECHA -->
        <dt class="col-sm-2">
            Fecha
        </dt>

        <dd class="col-sm-10">
            @Model.Fecha.ToShortDateString()
        </dd>


        <!-- HORA INICIO -->
        <dt class="col-sm-2">
            Hora Inicio
        </dt>

        <dd class="col-sm-10">
            @Model.HoraInicio
        </dd>


        <!-- HORA FIN -->
        <dt class="col-sm-2">
            Hora Fin
        </dt>

        <dd class="col-sm-10">
            @Model.HoraFin
        </dd>


        <!-- MOTIVO -->
        <dt class="col-sm-2">
            Motivo
        </dt>

        <dd class="col-sm-10">
            @Model.Motivo
        </dd>


        <!-- ESTADO -->
        <dt class="col-sm-2">
            Estado
        </dt>

        <dd class="col-sm-10">

            @if (estadoVisual == "Activa")
            {
                <span class="badge bg-success">Activa</span>
            }
            else if (estadoVisual == "Finalizada")
            {
                <span class="badge bg-dark">Finalizada</span>
            }
            else
            {
                <span class="badge bg-secondary">Cancelada</span>
            }

        </dd>


        <!-- SALA -->
        <dt class="col-sm-2">
            Sala
        </dt>

        <dd class="col-sm-10">
            @(Model.Sala?.Nombre ?? "No asignada")
        </dd>

    </dl>

</div>


<!-- ==========================================================
     BOTONES DE ACCIÓN
     ========================================================== -->

<div class="mt-3">

    <!-- EDITAR -->

    @if (puedeEditar)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Editar
        </a>
    }


    <!-- VOLVER -->

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>


    <!-- DESCARGAR ICS -->

    @if (puedeDescargar)
    {
        <a asp-action="DescargarICS"
           asp-route-id="@Model.Id"
           class="btn btn-info">
            📅 Añadir al calendario
        </a>
    }

</div>