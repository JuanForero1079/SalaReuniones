@page
@model SalaReuniones.Areas.Identity.Pages.Account.LoginModel

@{
    // ============================================================
    // TÍTULO DE LA PÁGINA
    // ============================================================
    ViewData["Title"] = "Ingreso al sistema";
}

<div class="row justify-content-center">
    <div class="col-md-4">

        <h3 class="text-center mb-4">Ingreso al Sistema</h3>

        <!-- ============================================================
             FORMULARIO DE LOGIN
        ============================================================ -->
        <form method="post">

            <!-- ============================================================
                 MENSAJE DE ERROR SOLO SI EXISTEN ERRORES
                 Evita mostrar el recuadro rojo cuando el login es correcto
            ============================================================ -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger"></div>
            }

            <!-- ============================================================
                 CAMPO: NOMBRE DE USUARIO
            ============================================================ -->
            <div class="form-group mb-3">

                <label asp-for="Input.UserName" class="form-label"></label>

                <input asp-for="Input.UserName"
                       class="form-control"
                       placeholder="Ingrese su usuario" />

                <span asp-validation-for="Input.UserName" class="text-danger"></span>

            </div>

            <!-- ============================================================
                 BOTÓN DE ENVÍO
            ============================================================ -->
            <button type="submit" class="btn btn-primary w-100">
                Ingresar
            </button>

        </form>

    </div>

</div>

<!-- ============================================================
     SCRIPTS DE VALIDACIÓN
============================================================ -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
